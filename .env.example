# auto (padrão) usa o Edge/Chrome instalado para Amazon e Mercado Livre; off desliga
KITESCOLA_NAVEGADOR=auto
# lojas a ignorar, separadas por vírgula (ids em src/lib/lojas/registro.ts)
KITESCOLA_LOJAS_OFF=
# Shopee pela API de afiliados (affiliate.shopee.com.br → Open API). Sem isso a Shopee não aparece.
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Proteção anti-robô (Cloudflare Turnstile) é EXIGIDA por padrão. Sem as chaves, busca, importação e
# otimização recusam (503/403). Só para uso no próprio computador: KITESCOLA_LOCAL=1 (ignorado na Netlify).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Segredo do passe assinado entre /api/buscar, /api/passe, /api/importar e /api/otimizar (obrigatório online)
KITESCOLA_SEGREDO=
# 1 = desliga a proteção anti-robô e os limites de uso (só no computador do desenvolvedor). NUNCA na Netlify.
KITESCOLA_LOCAL=0
# 1 = lojas simuladas (usado no teste e2e)
KITESCOLA_MOCK=0
# Mercado Livre pela API oficial (app em developers.mercadolivre.com.br, fluxo Client Credentials).
# Sem isso, o ML é buscado pelo navegador (sujeito à verificação anti-robô).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
